# Application
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SERVICE_NAME=rag-api

# PostgreSQL — localhost for local dev, Docker overrides with 'postgres'
POSTGRES_DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
# Jina AI — get free key at jina.ai
JINA_API_KEY=jina_c46d988de6484c9a915e814fd32e5b86ATZeDTSvKqoA6spdXA_iNuhfdnAQ

# Chunking settings
CHUNKING__CHUNK_SIZE=600
CHUNKING__OVERLAP_SIZE=100
CHUNKING__MIN_CHUNK_SIZE=100
CHUNKING__SECTION_BASED=true

# OpenSearch vector settings
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks

# OpenSearch settings
OPENSEARCH__HOST=http://localhost:9200
OPENSEARCH__INDEX_NAME=arxiv-papers
OPENSEARCH__MAX_TEXT_SIZE=1000000

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db